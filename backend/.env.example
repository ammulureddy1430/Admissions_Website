DATABASE_URL="postgresql://your_username:your_password@localhost:5432/admissionsos"
PORT=5001

# Authentication lifetimes
JWT_ACCESS_EXPIRY="1h"
JWT_REFRESH_EXPIRY="7d"

# Generate Test or Live API keys in the Razorpay Dashboard.
# Keep the secret on the backend only; never expose it to the browser.
RAZORPAY_KEY_ID="rzp_test_replace_me"
RAZORPAY_KEY_SECRET="replace_me"

# WhatsApp payment confirmations (Twilio Sandbox or an approved sender)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Source-grounded assessment generation with Google Vertex AI RAG Engine.
# Authenticate with Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS.
GOOGLE_CLOUD_PROJECT=""
VERTEX_RAG_LOCATION="us-central1"
VERTEX_RAG_MODEL="gemini-2.5-flash"
# Configure GOOGLE_APPLICATION_CREDENTIALS or workload identity in the runtime.
