datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  PRINCIPAL
  TEACHER
  COLLEGE_ADMIN
  ADMISSIONS_STAFF
  PARENT
  STUDENT
  MENTOR
  ALUMNI
}

model School {
  id                             String                          @id @default(uuid())
  name                           String                          @unique
  code                           String                          @unique
  subdomain                      String                          @unique
  customDomain                   String?                         @unique
  logo                           String?
  type                           String
  board                          String
  address                        String
  city                           String
  state                          String
  country                        String
  contactPerson                  String
  email                          String
  phone                          String
  website                        String?
  principalName                  String
  themeColor                     String?                         @default("#3b82f6")
  secondaryColor                 String?                         @default("#8b5cf6")
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  users                          User[]
  leads                          Lead[]
  applications                   Application[]
  documents                      Document[]
  studentDocuments               StudentDocument[]
  requiredDocuments              RequiredDocument[]
  storageUsage                   StorageUsage?
  interviews                     Interview[]
  payments                       Payment[]
  cmsPages                       CMSPage[]
  notifications                  Notification[]
  settings                       SchoolSettings?
  subscription                   Subscription?
  classes                        SchoolClass[]
  academicYears                  AcademicYear[]
  tenantRoles                    TenantRole[]
  higherEducationApplications    HigherEducationApplication[]
  emailTemplates                 EmailTemplate[]
  assessments                    Assessment[]
  questionBank                   QuestionBank[]
  assessmentReassignmentRequests AssessmentReassignmentRequest[]
  aiSourceLibrary                SchoolAiSourceLibrary?
  gameAssessments                GameAssessment[]
  gameTemplates                  GameTemplate[]
  realTimeGameAssignments        RealTimeGameAssignment[]
  curriculumBoards               CurriculumBoard[]
  curriculumGrades               CurriculumGrade[]
  curriculumSubjects             CurriculumSubject[]
  curriculumChapters             CurriculumChapter[]
  curriculumTopics               CurriculumTopic[]
  learningOutcomes               LearningOutcome[]
  gameCategories                 GameCategory[]
  curriculumAuditLogs            CurriculumAuditLog[]
  textbooks                      Textbook[]
  textbookPublishers             Publisher[]
  textbookAuthors                Author[]
  textbookLanguages              Language[]
  textbookAuditLogs              TextbookAuditLog[]
  notebookConnections            NotebookConnection[]
  processedTextbooks             ProcessedTextbook[]
  gameAIQuestions                GameAIQuestion[]
  questionGameMappings           QuestionGameMapping[]
  gameEngineDefinitions          GameEngineDefinition[]
  gameRuntimeSessions            GameRuntimeSession[]
  generatedGames                 GeneratedGame[]
  gamificationProfiles           GameGamificationProfile[]
  badgeDefinitions               GameBadgeDefinition[]
  gameChallenges                 GameChallenge[]
  gameAuditLogs                  GamePlatformAuditLog[]
}

model GameAssessment {
  id                 String                   @id @default(uuid())
  schoolId           String
  school             School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdById        String
  name               String
  description        String?                  @db.Text
  assessmentType     String
  assessmentMode     String
  subject            String
  ageGroup           String                   @map("age_group")
  section            String?
  chapter            String?
  topics             String[]
  teacherName        String?
  academicYear       String?
  difficulty         String
  language           String
  learningOutcome    String?                  @db.Text
  numberOfQuestions  Int
  numberOfGames      Int
  timeLimit          Int
  passingMarks       Int
  attemptLimit       Int
  startTime          DateTime?
  endTime            DateTime?
  dueDate            DateTime?
  settings           Json
  status             String                   @default("DRAFT")
  questions          GameQuestion[]
  assignments        GameAssignment[]
  analytics          GameAnalytics[]
  leaderboards       GameLeaderboard[]
  boardId            String?
  academicYearId     String?
  gradeId            String?
  subjectId          String?
  chapterId          String?
  topicId            String?
  learningOutcomeId  String?
  templateSelections GameAssessmentTemplate[]
  gameSelections     GameAssessmentGame[]
  gameResults        GameResult[]
  textbookId         String?
  textbookVersionId  String?
  aiQuestions        GameAIQuestion[]
  generatedGames     GeneratedGame[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([schoolId, status])
  @@index([schoolId, ageGroup, subject])
}

/// Global, tenant-independent game definitions. This is the master library;
/// assessment configuration and student results live in their own tables.
model Game {
  id                      String                    @id @default(uuid())
  name                    String
  slug                    String                    @unique
  description             String?                   @db.Text
  category                String
  ageGroup                String                    @map("age_group")
  difficulty              String
  durationSeconds         Int                       @map("duration_seconds")
  thumbnail               String?
  componentName           String                    @unique @map("component_name")
  gameType                String                    @map("game_type")
  status                  String                    @default("ACTIVE")
  isActive                Boolean                   @default(true) @map("is_active")
  assessments             GameAssessmentGame[]
  results                 GameResult[]
  followLightsAnalytics   FollowLightsAnalytics[]
  ballStackAnalytics      BallStackAnalytics[]
  soundDetectiveAnalytics SoundDetectiveAnalytics[]
  colorPathAnalytics      ColorPathAnalytics[]
  realTimeAssignments     RealTimeGameAssignment[]
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  @@index([status, isActive])
  @@index([category, ageGroup])
  @@map("games")
}

model RealTimeGameAssignment {
  id           String    @id @default(uuid())
  schoolId     String
  school       School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gameId       String
  game         Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  assignedById String
  ageGroup     String    @map("age_group")
  studentIds   String[]
  startsAt     DateTime?
  endsAt       DateTime?
  status       String    @default("ASSIGNED")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([schoolId, gameId, ageGroup, status])
  @@map("RealTimeGameAssignments")
}

model GameTemplate {
  id                  String                   @id @default(uuid())
  templateId          String
  schoolId            String
  school              School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name                String
  description         String?                  @db.Text
  categoryId          String
  category            GameCategory             @relation(fields: [categoryId], references: [id])
  difficulty          String                   @default("MEDIUM")
  estimatedDuration   Int
  minimumQuestions    Int
  maximumQuestions    Int
  supportedDevices    String[]
  thumbnail           String?
  previewImage        String?
  version             Int                      @default(1)
  status              String                   @default("DRAFT")
  createdById         String
  config              Json?
  mappings            GameTemplateMapping[]
  versions            GameTemplateVersion[]
  assessments         GameAssessmentTemplate[]
  recommendedMappings QuestionGameMapping[]    @relation("RecommendedGameTemplate")
  selectedMappings    QuestionGameMapping[]    @relation("SelectedGameTemplate")
  generatedGames      GeneratedGame[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([schoolId, templateId])
  @@index([schoolId, categoryId, status])
}

model GameQuestion {
  id               String         @id @default(uuid())
  gameAssessmentId String
  gameAssessment   GameAssessment @relation(fields: [gameAssessmentId], references: [id], onDelete: Cascade)
  sourceDocumentId String?
  type             String
  questionText     String         @db.Text
  options          Json?
  correctAnswer    String         @db.Text
  difficulty       String
  learningOutcome  String?        @db.Text
  hint             String?        @db.Text
  explanation      String?        @db.Text
  scoringRules     Json?
  approvalStatus   String         @default("PENDING")
  order            Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([gameAssessmentId, approvalStatus])
}

model GameAssignment {
  id                 String             @id @default(uuid())
  gameAssessmentId   String
  gameAssessment     GameAssessment     @relation(fields: [gameAssessmentId], references: [id], onDelete: Cascade)
  generatedGameId    String?
  generatedGame      GeneratedGame?     @relation(fields: [generatedGameId], references: [id], onDelete: Cascade)
  assignedById       String
  targetType         String
  targetIds          String[]
  scheduledAt        DateTime?
  dueDate            DateTime?
  startDate          DateTime?
  endDate            DateTime?
  maxAttempts        Int                @default(1)
  timeLimitMinutes   Int?
  passingScore       Float              @default(60)
  allowRestart       Boolean            @default(false)
  assignmentSettings Json?
  status             String             @default("ASSIGNED")
  results            GameResult[]
  notifications      GameNotification[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([gameAssessmentId, status])
  @@index([generatedGameId, status])
}

model GameResult {
  id                      String                   @id @default(uuid())
  gameAssignmentId        String
  gameAssignment          GameAssignment           @relation(fields: [gameAssignmentId], references: [id], onDelete: Cascade)
  studentId               String
  gameId                  String?
  game                    Game?                    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  assessmentId            String?
  assessment              GameAssessment?          @relation(fields: [assessmentId], references: [id], onDelete: SetNull)
  status                  String                   @default("NOT_STARTED")
  totalScore              Float                    @default(0)
  percentage              Float                    @default(0)
  passed                  Boolean?
  startedAt               DateTime?
  completedAt             DateTime?
  attempts                GameAttempt[]
  runtimeSessions         GameRuntimeSession[]
  rewards                 GameReward[]
  certificate             GameCertificate?
  followLightsAnalytics   FollowLightsAnalytics?
  ballStackAnalytics      BallStackAnalytics?
  soundDetectiveAnalytics SoundDetectiveAnalytics?
  colorPathAnalytics      ColorPathAnalytics?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@unique([gameAssignmentId, studentId])
  @@index([studentId, status])
  @@index([gameId, studentId])
  @@index([assessmentId, studentId])
}

model FollowLightsAnalytics {
  id                   String     @id @default(uuid())
  studentId            String
  assessmentId         String
  gameId               String
  gameResultId         String     @unique
  gameResult           GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  game                 Game       @relation(fields: [gameId], references: [id])
  totalSequences       Int
  completedSequences   Int
  longestSequence      Int
  mistakes             Int
  correctTaps          Int
  wrongTaps            Int
  averageReactionTime  Float
  averageTapDelay      Float
  completionPercentage Float
  memoryScore          Float
  focusScore           Float
  processingSpeed      Float
  learningPotential    Float
  accuracy             Float
  attention            Float
  visualMemory         Float
  overallScore         Float
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([gameId, assessmentId])
  @@index([studentId, assessmentId])
  @@map("FollowLightsAnalytics")
}

model BallStackAnalytics {
  id                       String     @id @default(uuid())
  studentId                String
  assessmentId             String
  gameId                   String
  gameResultId             String     @unique
  gameResult               GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  game                     Game       @relation(fields: [gameId], references: [id])
  totalBallsDropped        Int
  successfulPlacements     Int
  failedPlacements         Int
  highestTowerHeight       Int
  averageAlignment         Float
  perfectPlacements        Int
  averageReactionTime      Float
  towerStabilityScore      Float
  handEyeCoordinationScore Float
  fineMotorScore           Float
  precisionScore           Float
  concentrationScore       Float
  patienceScore            Float
  reactionSpeedScore       Float
  consistencyScore         Float
  timingAccuracyScore      Float
  overallCognitiveScore    Float
  completionStatus         String
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([gameId, assessmentId])
  @@index([studentId, assessmentId])
  @@map("BallStackAnalytics")
}

model GameAttempt {
  id            String      @id @default(uuid())
  gameResultId  String
  gameResult    GameResult  @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  attemptNumber Int
  state         Json?
  startedAt     DateTime    @default(now())
  submittedAt   DateTime?
  scores        GameScore[]

  @@unique([gameResultId, attemptNumber])
}

model GameScore {
  id            String      @id @default(uuid())
  gameAttemptId String
  gameAttempt   GameAttempt @relation(fields: [gameAttemptId], references: [id], onDelete: Cascade)
  gameKey       String
  score         Float
  maxScore      Float
  timeTaken     Int?
  details       Json?
  createdAt     DateTime    @default(now())
}

model GameReward {
  id           String     @id @default(uuid())
  gameResultId String
  gameResult   GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  rewardType   String
  name         String
  metadata     Json?
  awardedAt    DateTime   @default(now())
}

model GameLeaderboard {
  id               String         @id @default(uuid())
  schoolId         String
  gameAssessmentId String
  gameAssessment   GameAssessment @relation(fields: [gameAssessmentId], references: [id], onDelete: Cascade)
  scope            String
  rankings         Json
  calculatedAt     DateTime       @default(now())

  @@index([schoolId, gameAssessmentId])
}

model GameAnalytics {
  id               String         @id @default(uuid())
  gameAssessmentId String
  gameAssessment   GameAssessment @relation(fields: [gameAssessmentId], references: [id], onDelete: Cascade)
  metricType       String
  dimensions       Json?
  metrics          Json
  calculatedAt     DateTime       @default(now())

  @@index([gameAssessmentId, metricType])
}

model GameAchievement {
  id          String   @id @default(uuid())
  schoolId    String
  studentId   String
  key         String
  name        String
  description String?
  metadata    Json?
  earnedAt    DateTime @default(now())

  @@unique([schoolId, studentId, key])
}

model GameGamificationProfile {
  id                String                   @id @default(uuid())
  schoolId          String
  school            School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId         String
  xp                Int                      @default(0)
  coins             Int                      @default(0)
  level             Int                      @default(1)
  currentStreak     Int                      @default(0)
  longestStreak     Int                      @default(0)
  gamesPlayed       Int                      @default(0)
  gamesPassed       Int                      @default(0)
  lastPlayedAt      DateTime?
  transactions      GameEconomyTransaction[]
  badges            GameStudentBadge[]
  challengeProgress GameChallengeProgress[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([schoolId, studentId])
  @@index([schoolId, xp])
  @@map("GameGamificationProfiles")
}

model GameEconomyTransaction {
  id          String                  @id @default(uuid())
  profileId   String
  profile     GameGamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type        String
  xpDelta     Int                     @default(0)
  coinDelta   Int                     @default(0)
  reason      String
  referenceId String?
  metadata    Json?
  createdAt   DateTime                @default(now())

  @@index([profileId, createdAt])
  @@map("GameEconomyTransactions")
}

model GameBadgeDefinition {
  id          String             @id @default(uuid())
  schoolId    String
  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  badgeKey    String
  name        String
  description String?
  icon        String?
  criteria    Json
  status      String             @default("ACTIVE")
  students    GameStudentBadge[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([schoolId, badgeKey])
  @@map("GameBadgeDefinitions")
}

model GameStudentBadge {
  id        String                  @id @default(uuid())
  profileId String
  profile   GameGamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     GameBadgeDefinition     @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  reason    String?
  earnedAt  DateTime                @default(now())

  @@unique([profileId, badgeId])
  @@map("GameStudentBadges")
}

model GameChallenge {
  id           String                  @id @default(uuid())
  schoolId     String
  school       School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  challengeKey String
  name         String
  description  String?
  frequency    String
  targetType   String
  targetValue  Int
  xpReward     Int                     @default(0)
  coinReward   Int                     @default(0)
  startsAt     DateTime
  endsAt       DateTime
  status       String                  @default("ACTIVE")
  progress     GameChallengeProgress[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([schoolId, challengeKey])
  @@index([schoolId, status, startsAt, endsAt])
  @@map("GameChallenges")
}

model GameChallengeProgress {
  id          String                  @id @default(uuid())
  challengeId String
  challenge   GameChallenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  profileId   String
  profile     GameGamificationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  progress    Int                     @default(0)
  completed   Boolean                 @default(false)
  completedAt DateTime?
  updatedAt   DateTime                @updatedAt

  @@unique([challengeId, profileId])
  @@map("GameChallengeProgress")
}

model GamePlatformAuditLog {
  id         String   @id @default(uuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  actorId    String
  operation  String
  entityType String
  entityId   String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([schoolId, entityType, entityId, createdAt])
  @@map("GamePlatformAuditLogs")
}

model GameCertificate {
  id            String     @id @default(uuid())
  gameResultId  String     @unique
  gameResult    GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  certificateNo String     @unique
  fileUrl       String?
  issuedAt      DateTime   @default(now())
}

model GameNotification {
  id               String         @id @default(uuid())
  gameAssignmentId String
  gameAssignment   GameAssignment @relation(fields: [gameAssignmentId], references: [id], onDelete: Cascade)
  userId           String
  type             String
  title            String
  message          String         @db.Text
  readAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([userId, readAt])
}

model SchoolAiSourceLibrary {
  id            String                   @id @default(uuid())
  schoolId      String                   @unique
  school        School                   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ragCorpusName String                   @unique
  documents     SchoolAiSourceDocument[]
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
}

model SchoolAiSourceDocument {
  id             String                @id @default(uuid())
  libraryId      String
  library        SchoolAiSourceLibrary @relation(fields: [libraryId], references: [id], onDelete: Cascade)
  sourceName     String
  originalName   String
  mimeType       String
  fileSize       Int
  grade          String?
  subject        String?
  chapter        String?
  uploadedById   String
  ragFileName    String?               @unique
  extractedText  String?               @db.Text
  processingMode String                @default("GOOGLE")
  status         String                @default("PROCESSING")
  errorMessage   String?               @db.Text
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([libraryId, status])
  @@index([libraryId, grade, subject])
}

model SchoolClass {
  id        String   @id @default(uuid())
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([schoolId, name])
}

model AcademicYear {
  id        String            @id @default(uuid())
  schoolId  String
  school    School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  boardId   String?
  board     CurriculumBoard?  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean           @default(true)
  status    String            @default("ACTIVE")
  grades    CurriculumGrade[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, boardId, status])
}

model CurriculumBoard {
  id            String            @id @default(uuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?           @db.Text
  status        String            @default("ACTIVE")
  academicYears AcademicYear[]
  grades        CurriculumGrade[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([schoolId, code])
  @@index([schoolId, status])
  @@map("Boards")
}

model CurriculumGrade {
  id             String              @id @default(uuid())
  schoolId       String
  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  boardId        String
  board          CurriculumBoard     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int
  status         String              @default("ACTIVE")
  subjects       CurriculumSubject[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([schoolId, boardId, academicYearId, name])
  @@index([schoolId, boardId, academicYearId, status])
  @@map("Grades")
}

model CurriculumSubject {
  id          String              @id @default(uuid())
  schoolId    String
  school      School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeId     String
  grade       CurriculumGrade     @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?             @db.Text
  isCustom    Boolean             @default(false)
  status      String              @default("ACTIVE")
  chapters    CurriculumChapter[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@unique([schoolId, gradeId, name])
  @@index([schoolId, gradeId, status])
  @@map("Subjects")
}

model CurriculumChapter {
  id                     String            @id @default(uuid())
  schoolId               String
  school                 School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId              String
  subject                CurriculumSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name                   String
  chapterNumber          Int
  description            String?           @db.Text
  estimatedTeachingHours Float?
  status                 String            @default("ACTIVE")
  learningObjectives     String[]
  topics                 CurriculumTopic[]
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@unique([schoolId, subjectId, chapterNumber])
  @@index([schoolId, subjectId, status])
  @@map("Chapters")
}

model CurriculumTopic {
  id                 String            @id @default(uuid())
  schoolId           String
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  chapterId          String
  chapter            CurriculumChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name               String
  description        String?           @db.Text
  difficulty         String            @default("MEDIUM")
  estimatedDuration  Int?
  learningObjectives String[]
  status             String            @default("ACTIVE")
  learningOutcomes   LearningOutcome[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([schoolId, chapterId, name])
  @@index([schoolId, chapterId, status])
  @@map("Topics")
}

model LearningOutcome {
  id          String          @id @default(uuid())
  schoolId    String
  school      School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  topicId     String
  topic       CurriculumTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  outcome     String          @db.Text
  outcomeCode String
  bloomLevel  String
  difficulty  String          @default("MEDIUM")
  status      String          @default("ACTIVE")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([schoolId, outcomeCode])
  @@index([schoolId, topicId, status])
  @@map("LearningOutcomes")
}

model GameCategory {
  id          String         @id @default(uuid())
  schoolId    String
  school      School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name        String
  description String?        @db.Text
  status      String         @default("ACTIVE")
  templates   GameTemplate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([schoolId, name])
  @@index([schoolId, status])
  @@map("GameCategories")
}

model GameTemplateMapping {
  id                String       @id @default(uuid())
  templateId        String
  template          GameTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  gradeId           String?
  subjectId         String?
  chapterId         String?
  topicId           String?
  learningOutcomeId String?
  createdAt         DateTime     @default(now())

  @@index([templateId])
  @@index([gradeId, subjectId, chapterId, topicId, learningOutcomeId])
  @@map("GameTemplateMappings")
}

model GameTemplateVersion {
  id          String       @id @default(uuid())
  templateId  String
