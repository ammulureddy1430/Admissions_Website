  verifiedDocuments                   StudentDocument[]                @relation("DocumentVerifier")
  uploadedVersions                    DocumentVersion[]                @relation("VersionUploader")
  performedLogs                       DocumentVerificationLog[]        @relation("LogPerformer")
  documentComments                    DocumentComment[]
  downloadedDocs                      DocumentDownload[]               @relation("DocumentDownloader")
  viewedDocs                          DocumentAccessLog[]              @relation("DocumentViewer")
  assessmentNotifications             AssessmentNotification[]
  reassessmentRequests                AssessmentReassignmentRequest[]  @relation("ReassessmentRequester")
