  resumes             ResumeReview[]
  featured            Boolean                    @default(false)
  responseTimeMinutes Int?
  headline            String?
  timezone            String                     @default("UTC")
  targetDestinations  Json                       @default("[]")
  sessionTypes        MentorSessionType[]
  categories          MentorCategoryAssignment[]
  followers           MentorFollow[]
  savedBy             SavedMentor[]
  assignedProjects    Project[]
  resources           MentorResource[]
}

model Session {
  id                 String             @id @default(uuid())
  mentorId           String
  mentor             Mentor             @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  studentId          String
  student            User               @relation("StudentSessions", fields: [studentId], references: [id], onDelete: Cascade)
  date               String
  time               String
  duration           Int                @default(30) // in minutes
  topic              String
  questions          String?            @db.Text
  status             String             @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED
  meetingLink        String?
  reviewRating       Float?
  reviewText         String?            @db.Text
  startsAt           DateTime?
  endsAt             DateTime?
  timezone           String             @default("UTC")
  sessionTypeId      String?
  sessionType        MentorSessionType? @relation(fields: [sessionTypeId], references: [id], onDelete: SetNull)
  priceAmount        Decimal?           @db.Decimal(10, 2)
  currency           String             @default("INR")
  cancellationReason String?
  cancelledById      String?
  attendanceStatus   String?
  mentorNotes        String?            @db.Text
  studentNotes       String?            @db.Text
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  resources          SessionResource[]
  tasks              SessionTask[]

  @@index([mentorId, startsAt, status])
  @@index([studentId, startsAt, status])
}

model Review {
