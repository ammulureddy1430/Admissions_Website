  id         String   @id @default(uuid())
  schoolId   String
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  subject    String
  body       String   @db.Text
  version    Int      @default(1)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([schoolId])
}

model EmailDraft {
  id             String            @id @default(uuid())
  applicationId  String            @unique
  application    Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject        String
  body           String            @db.Text
  lastEditedById String?
  lastEditedBy   User?             @relation("DraftEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  attachments    EmailAttachment[]
  updatedAt      DateTime          @updatedAt
}

model EmailHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  subject       String
  body          String            @db.Text
  status        String            @default("SENT") // DRAFT, SENT, DELIVERED, OPENED, FAILED
  sentById      String?
  sentBy        User?             @relation("HistorySender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt        DateTime          @default(now())
  messageId     String?
  emailId       String?
  attachments   EmailAttachment[]
  logs          EmailLog[]
  tracking      EmailTracking[]

  @@index([applicationId])
}

model EmailLog {
  id           String       @id @default(uuid())
  historyId    String
  history      EmailHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  status       String
  errorMessage String?      @db.Text
  createdAt    DateTime     @default(now())
}

model EmailTracking {
  id        String       @id @default(uuid())
  historyId String
  history   EmailHistory @relation(fields: [historyId], references: [id], onDelete: Cascade)
  event     String // DELIVERED, OPENED, BOUNCE, SPAM, CLICKED
  recipient String
  timestamp DateTime     @default(now())
}

model EmailAttachment {
  id        String        @id @default(uuid())
  name      String
  url       String
  type      String
  draftId   String?
  draft     EmailDraft?   @relation(fields: [draftId], references: [id], onDelete: Cascade)
  historyId String?
  history   EmailHistory? @relation(fields: [historyId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

model DocumentCategory {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requiredDocuments RequiredDocument[]
  studentDocuments  StudentDocument[]
}

model RequiredDocument {
  id            String           @id @default(uuid())
  schoolId      String
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  categoryId    String
  category      DocumentCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name          String
  isRequired    Boolean          @default(true)
  isConditional Boolean          @default(false)
  conditionRule String?
  grade         String?
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  templates        DocumentTemplate[]
  studentDocuments StudentDocument[]
}

model DocumentTemplate {
  id                 String           @id @default(uuid())
  requiredDocumentId String
  requiredDocument   RequiredDocument @relation(fields: [requiredDocumentId], references: [id], onDelete: Cascade)
  name               String
  fileUrl            String
  fileType           String
  fileSize           Int
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model StudentDocument {
  id                 String            @id @default(uuid())
  schoolId           String
  school             School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId      String
  application        Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requiredDocumentId String?
  requiredDocument   RequiredDocument? @relation(fields: [requiredDocumentId], references: [id], onDelete: SetNull)
  categoryId         String
  category           DocumentCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  name           String
  fileName       String
  fileType       String
  fileSize       Int
  url            String
  currentVersion Int    @default(1)
  status         String @default("PENDING")

  uploadedById String?
  uploadedBy   User?   @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  rejectionReason String?
  remarks         String?
  rejectedById    String?
  rejectedBy      User?     @relation("DocumentRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)
  rejectedAt      DateTime?

  verifiedById String?
  verifiedBy   User?     @relation("DocumentVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?

  expiryDate DateTime?
  isArchived Boolean   @default(false)
  checksum   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions         DocumentVersion[]
  comments         DocumentComment[]
  verificationLogs DocumentVerificationLog[]
  downloads        DocumentDownload[]
  accessLogs       DocumentAccessLog[]
}

model DocumentVersion {
  id                String          @id @default(uuid())
  studentDocumentId String
  studentDocument   StudentDocument @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)
  versionNumber     Int
  fileName          String
  fileType          String
  fileSize          Int
  url               String
  checksum          String?
  uploadedById      String?
  uploadedBy        User?           @relation("VersionUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
}

model DocumentVerificationLog {
  id                String          @id @default(uuid())
  studentDocumentId String
  studentDocument   StudentDocument @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)
  status            String
  action            String
  remarks           String?
  performedById     String?
  performedBy       User?           @relation("LogPerformer", fields: [performedById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
}

model DocumentComment {
  id                String          @id @default(uuid())
  studentDocumentId String
  studentDocument   StudentDocument @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)
  text              String
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
}

model DocumentAuditLog {
  id           String   @id @default(uuid())
  schoolId     String?
  userId       String?
  action       String
  documentId   String?
  documentName String?
  details      String?
  ipAddress    String?
  device       String?
  createdAt    DateTime @default(now())
}

model DocumentDownload {
  id                String          @id @default(uuid())
  studentDocumentId String
  studentDocument   StudentDocument @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)
  downloadedById    String?
  downloadedBy      User?           @relation("DocumentDownloader", fields: [downloadedById], references: [id], onDelete: SetNull)
  ipAddress         String?
  device            String?
  createdAt         DateTime        @default(now())
}

model DocumentAccessLog {
  id                String          @id @default(uuid())
  studentDocumentId String
  studentDocument   StudentDocument @relation(fields: [studentDocumentId], references: [id], onDelete: Cascade)
  accessedById      String?
  accessedBy        User?           @relation("DocumentViewer", fields: [accessedById], references: [id], onDelete: SetNull)
  ipAddress         String?
  device            String?
  createdAt         DateTime        @default(now())
}

model DocumentNotification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StorageUsage {
  id            String   @id @default(uuid())
  schoolId      String   @unique
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  bytesUsed     BigInt   @default(0)
  documentCount Int      @default(0)
  updatedAt     DateTime @updatedAt
}

model Assessment {
  id                     String                          @id @default(uuid())
  schoolId               String
  school                 School                          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  applicationId          String?
  application            Application?                    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  title                  String
  description            String?                         @db.Text
  instructions           String?                         @db.Text
  grade                  String
  subject                String
  difficulty             String // EASY, MEDIUM, HARD
  questionCount          Int
  timeLimit              Int // in minutes
  totalMarks             Float
  passingMarks           Float
  dueDate                DateTime?
  allowCalculator        Boolean                         @default(false)
  shuffleQuestions       Boolean                         @default(false)
  shuffleOptions         Boolean                         @default(false)
  showResultImmediately  Boolean                         @default(false)
  allowRetake            Boolean                         @default(false)
  retakeCount            Int                             @default(1)
  status                 String                          @default("DRAFT") // DRAFT, PUBLISHED
  assessmentMode         String                          @default("HOME") // HOME, SCHOOL, BOTH
  venueChoice            String? // HOME or SCHOOL; required for BOTH assignments
  venueChoiceSubmittedAt DateTime?
  proctoringEnabled      Boolean                         @default(false)
  attemptNumber          Int                             @default(1)
  assessmentVersion      Int                             @default(1)
  previousAssessmentId   String?
  previousAssessment     Assessment?                     @relation("AssessmentVersions", fields: [previousAssessmentId], references: [id], onDelete: SetNull)
  reassignedAssessments  Assessment[]                    @relation("AssessmentVersions")
  archivedAt             DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  questions              AssessmentQuestion[]
  submissions            AssessmentSubmission[]
  results                AssessmentResult[]
  notifications          AssessmentNotification[]
  reassignmentRequests   AssessmentReassignmentRequest[] @relation("RequestedAssessment")
  generatedByRequest     AssessmentReassignmentRequest?  @relation("GeneratedAssessment")
  textbookId             String?
  textbookVersionId      String?

  hasWritten   Boolean @default(true)
  hasReading   Boolean @default(false)
  hasSpeaking  Boolean @default(false)
  hasListening Boolean @default(false)

  // Reading Config
  readingMaterialType   String? // PASSAGE, STORY, POEM, PDF, IMAGE, WORD
  readingMaterialUrl    String?
  readingText           String? @db.Text
  readingTime           Int? // In seconds
  readingRecordDuration Int? // In seconds
  readingInstructions   String? @db.Text
  readingTotalMarks     Float?
  readingPassingMarks   Float?

  // Speaking Config
  speakingActivityType String? // Introduce Yourself, Picture Description, etc.
  speakingMaterialType String? // PROMPT, IMAGE, AUDIO, VIDEO, AI_TOPIC
  speakingMaterialUrl  String?
  speakingPrompt       String? @db.Text
  speakingPrepTime     Int? // In seconds
  speakingTimeLimit    Int? // In seconds
  speakingTotalMarks   Float?
  speakingPassingMarks Float?

  // Listening Config
  listeningActivityType String?
  listeningMaterialType String? // AUDIO, VIDEO, RECORD, AI_GEN
  listeningMaterialUrl  String?
  listeningTranscript   String? @db.Text
  listeningInstructions String? @db.Text
  listeningPlaysAllowed Int?    @default(1)
  listeningAudioSpeed   Float?  @default(1.0)
  listeningPrepTime     Int? // In seconds (30, 60, 120)
  listeningDuration     Int? // Auto-calculated or stored duration in seconds
  listeningTotalMarks   Float?
  listeningPassingMarks Float?
  listeningTimeLimit    Int? // Time limit for answering in minutes/seconds

  schedule     AssessmentSchedule?
  slotBookings StudentSlotBooking[]

  @@index([schoolId, status])
}

model AssessmentQuestion {
  id            String             @id @default(uuid())
  assessmentId  String
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  type          String // MCQ, WRITTEN, FILE_UPLOAD
  questionText  String             @db.Text
  options       Json? // For MCQ: e.g. ["Option A", "Option B", ...]
  correctAnswer String? // Correct answer option or written baseline response
  explanation   String?            @db.Text
  marks         Float
  order         Int                @default(0)
  isListening   Boolean            @default(false)
  createdAt     DateTime           @default(now())
  answers       AssessmentAnswer[]
}

model QuestionBank {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade         String
  subject       String
  topic         String?
  difficulty    String // EASY, MEDIUM, HARD
  type          String // MCQ, WRITTEN, FILE_UPLOAD
  questionText  String   @db.Text
  options       Json?
  correctAnswer String?
  explanation   String?  @db.Text
  usageCount    Int      @default(0)
  status        String   @default("ACTIVE")
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([schoolId, grade, subject])
}

model AssessmentSubmission {
  id                    String                          @id @default(uuid())
  assessmentId          String
  assessment            Assessment                      @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  applicationId         String
  application           Application                     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status                String                          @default("IN_PROGRESS") // IN_PROGRESS, SUBMITTED, EVALUATED
  attemptNumber         Int                             @default(1)
  assessmentVersion     Int                             @default(1)
  previousSubmissionId  String?
  previousSubmission    AssessmentSubmission?           @relation("SubmissionAttempts", fields: [previousSubmissionId], references: [id], onDelete: SetNull)
  subsequentSubmissions AssessmentSubmission[]          @relation("SubmissionAttempts")
  startedAt             DateTime?
  submittedAt           DateTime?
  timeTaken             Int? // in seconds
  createdAt             DateTime                        @default(now())
  updatedAt             DateTime                        @updatedAt
  answers               AssessmentAnswer[]
  reassignmentRequests  AssessmentReassignmentRequest[]
  totalWarnings         Int                             @default(0)
  tabSwitchCount        Int                             @default(0)
  fullscreenExitCount   Int                             @default(0)
  submissionReason      String?                         @default("NORMAL")
  securityLogs          AssessmentSecurityLog[]

  // Reading Submission
  readingAudioUrl       String?
  readingAiScore        Float?
  readingManualScore    Float?
  readingEvaluation     Json? // Details like fluency, accuracy, etc.
  readingTeacherRemarks String? @db.Text

  // Speaking Submission
  speakingVideoUrl       String?
  speakingAiScore        Float?
  speakingManualScore    Float?
  speakingEvaluation     Json? // Details like pronunciation, eye contact, etc.
  speakingTeacherRemarks String? @db.Text

  // Listening Submission
  listeningPlaysUsed      Int     @default(0)
  listeningTimeTaken      Int? // In seconds
  listeningAiScore        Float?
  listeningManualScore    Float?
  listeningEvaluation     Json? // Details like accuracy, comprehension, attention, etc.
  listeningTeacherRemarks String? @db.Text
}

model AssessmentReassignmentRequest {
  id                    String                           @id @default(uuid())
  assessmentId          String
  assessment            Assessment                       @relation("RequestedAssessment", fields: [assessmentId], references: [id], onDelete: Restrict)
  previousAttemptId     String
  previousAttempt       AssessmentSubmission             @relation(fields: [previousAttemptId], references: [id], onDelete: Restrict)
  applicationId         String
  application           Application                      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  parentId              String
  parent                User                             @relation("ReassessmentRequester", fields: [parentId], references: [id], onDelete: Cascade)
  schoolId              String
  school                School                           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  generatedAssessmentId String?                          @unique
  generatedAssessment   Assessment?                      @relation("GeneratedAssessment", fields: [generatedAssessmentId], references: [id], onDelete: SetNull)
  status                String                           @default("PENDING") // PENDING, APPROVED, REJECTED
  requestReason         String?                          @db.Text
  rejectionReason       String?                          @db.Text
  approvedById          String?
  approvedBy            User?                            @relation("ReassessmentApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt            DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  auditLogs             AssessmentReassignmentAuditLog[]

  @@index([schoolId, status, createdAt])
  @@index([parentId, status])
  @@index([applicationId, createdAt])
}

model AssessmentReassignmentAuditLog {
  id            String                        @id @default(uuid())
  requestId     String
  request       AssessmentReassignmentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  action        String
  performedById String
  performedBy   User                          @relation(fields: [performedById], references: [id], onDelete: Restrict)
  details       Json?
  createdAt     DateTime                      @default(now())

  @@index([requestId, createdAt])
}

model AssessmentAnswer {
  id             String               @id @default(uuid())
  submissionId   String
  submission     AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId     String
  question       AssessmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption String? // For MCQ
  writtenAnswer  String?              @db.Text // For WRITTEN
  fileUrl        String? // For FILE_UPLOAD
  fileName       String? // For FILE_UPLOAD
  marksObtained  Float?
  isCorrect      Boolean?
  teacherRemarks String?              @db.Text
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([submissionId, questionId])
}

model AssessmentResult {
  id              String      @id @default(uuid())
  assessmentId    String
  assessment      Assessment  @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  score           Float
  percentage      Float
  correctCount    Int
  wrongCount      Int
  status          String // PASS, FAIL, NEEDS_IMPROVEMENT
  remarks         String?     @db.Text
  teacherComments String?     @db.Text
  publishedAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([assessmentId, applicationId])
}

model AssessmentNotification {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  message      String
  type         String // ASSIGNED, SUBMITTED, RESULT_PUBLISHED, DUE_REMINDER
  status       String     @default("PENDING")
  readAt       DateTime?
  createdAt    DateTime   @default(now())

  @@index([userId, status])
}

model AssessmentSecurityLog {
  id           String               @id @default(uuid())
  submissionId String
  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  eventType    String // STARTED, FULLSCREEN_ENTER, FULLSCREEN_EXIT, TAB_CHANGED, FOCUS_LOST, FOCUS_REGAINED, WARNING, TERMINATED
  details      String?              @db.Text
  ipAddress    String?
  browser      String?
  device       String?
  createdAt    DateTime             @default(now())

  @@index([submissionId, eventType])
}

model AssessmentSchedule {
  id                       String           @id @default(uuid())
  assessmentId             String           @unique
  assessment               Assessment       @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  assessmentDate           DateTime
  campus                   String
  building                 String
  floor                    String
  roomNumber               String
  venue                    String?          @db.Text
  instructions             String?          @db.Text
  contactPerson            String
  contactPhone             String
  contactEmail             String
  documentsRequired        String[]
  allowStudentRescheduling Boolean          @default(false)
  createdBy                String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  slots                    AssessmentSlot[]

  @@map("AssessmentSchedules")
}

model AssessmentSlot {
  id                   String               @id @default(uuid())
  assessmentScheduleId String
  schedule             AssessmentSchedule   @relation(fields: [assessmentScheduleId], references: [id], onDelete: Cascade)
  slotName             String
  startTime            String
  endTime              String
  capacity             Int
  bookedCount          Int                  @default(0)
  status               String               @default("AVAILABLE") // AVAILABLE, FULL
  bookings             StudentSlotBooking[]

  @@index([assessmentScheduleId])
  @@map("AssessmentSlots")
}

model StudentSlotBooking {
  id               String         @id @default(uuid())
  assessmentId     String
  assessment       Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  studentId        String
  application      Application    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parentId         String?
  parent           User?          @relation("ParentBookings", fields: [parentId], references: [id], onDelete: SetNull)
  slotId           String
  slot             AssessmentSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  bookingStatus    String         @default("BOOKED") // PENDING, BOOKED, CANCELLED, RESCHEDULED, COMPLETED, ABSENT
  attendanceStatus String         @default("PENDING") // PENDING, PRESENT, ABSENT, LATE, COMPLETED
  bookedAt         DateTime       @default(now())
  remarks          String?        @db.Text

  @@unique([assessmentId, studentId])
  @@index([slotId])
  @@index([studentId])
  @@map("StudentSlotBookings")
}

model SoundDetectiveAnalytics {
  id                       String     @id @default(uuid())
  studentId                String
  assessmentId             String
  gameId                   String
  gameResultId             String     @unique
  gameResult               GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  game                     Game       @relation(fields: [gameId], references: [id])
  roundsPlayed             Int
  correctResponses         Int
  incorrectResponses       Int
  averageResponseTime      Float
  listeningScore           Float
  auditoryRecognitionScore Float
  completionPercentage     Float
  overallScore             Float
  highestDifficulty        Int
  completionStatus         String
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([gameId, assessmentId])
  @@index([studentId, assessmentId])
  @@map("SoundDetectiveAnalytics")
}

model ColorPathAnalytics {
  id                     String     @id @default(uuid())
  studentId              String
  assessmentId           String
  gameId                 String
  gameResultId           String     @unique
  gameResult             GameResult @relation(fields: [gameResultId], references: [id], onDelete: Cascade)
  game                   Game       @relation(fields: [gameId], references: [id])
  roundsPlayed           Int
  correctSelections      Int
  incorrectSelections    Int
  averageResponseTime    Float
  observationAccuracy    Float
  observationScore       Float
  visualRecognitionScore Float
  highestDifficulty      Int
  completionPercentage   Float
  overallScore           Float
  completionStatus       String
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  @@index([gameId, assessmentId])
  @@index([studentId, assessmentId])
  @@map("ColorPathAnalytics")
}
