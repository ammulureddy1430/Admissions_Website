model Mentor {
  id                  String                     @id @default(uuid())
  userId              String                     @unique
  user                User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio                 String
  position            String
  company             String
  university          String
  country             String
  yearsExperience     Int
  languages           Json // Array of strings e.g. ["English", "Hindi"]
  rating              Float                      @default(5.0)
  skills              Json // Array of strings
  sessionPrice        Float                      @default(0.0)
  about               String                     @db.Text
  education           Json // Array of objects e.g. [{ degree: "CS", institution: "Stanford", year: "2018" }]
  experience          Json // Array of objects e.g. [{ role: "Lead Engineer", company: "Google", duration: "2020-Present" }]
  achievements        Json // Array of strings
  research            Json // Array of strings
  certifications      Json // Array of strings
  verified            Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  sessions            Session[]
  availability        AvailabilitySlot[]
